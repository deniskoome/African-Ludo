<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.motion.widget.MotionLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/matchMotionLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/spacing_4"
    android:background="?attr/colorSurface"
    app:layoutDescription="@xml/motion_scene_match"
    tools:context="com.tomtomkenya.africanludo.fragment.MatchFragment">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/matchCelebrationCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:padding="@dimen/spacing_4"
        android:visibility="visible"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="?attr/colorSecondaryContainer"
        app:cardCornerRadius="@dimen/corner_large"
        app:cardElevation="@dimen/elevation_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="@dimen/spacing_2">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="@dimen/spacing_2"
                android:contentDescription="@string/match_found_icon"
                android:src="@drawable/ic_dice"
                android:tint="?attr/colorOnSecondaryContainer" />

            <TextView
                style="@style/TextStyle.Ludo.TitleMedium"
                android:gravity="center"
                android:text="@string/match_found_title"
                android:textColor="?attr/colorOnSecondaryContainer" />

            <TextView
                style="@style/TextStyle.Ludo.BodyMedium"
                android:gravity="center"
                android:layout_marginTop="@dimen/spacing_1"
                android:text="@string/match_found_message"
                android:textColor="?attr/colorOnSecondaryContainer" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/matchCelebrationLottie"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="@dimen/spacing_3"
                android:contentDescription="@string/match_found_animation_desc"
                android:importantForAccessibility="no"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"
                app:lottie_rawRes="@raw/lottie_dice_roll"
                app:lottie_speed="1.2" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2"
        style="@style/Widget.Material3.TabLayout"
        android:background="@android:color/transparent"
        android:paddingBottom="@dimen/spacing_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/matchCelebrationCard"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabIndicatorFullWidth="false"
        app:tabRippleColor="?attr/colorPrimary"
        tools:targetApi="lollipop" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayout" />

</androidx.constraintlayout.motion.widget.MotionLayout>
