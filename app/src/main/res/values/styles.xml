<resources>
    <style name="AppTheme" parent="Theme.Ludo" />

    <style name="AppTheme.NoActionBar" parent="Theme.Ludo">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="ToolbarTheme" parent="ThemeOverlay.Material3.Toolbar">
        <item name="titleTextColor">@color/ludo_on_surface</item>
    </style>

    <style name="viewParent">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="viewParent.headerText" parent="TextStyle.Ludo.TitleMedium">
        <item name="android:textColor">@color/ludo_on_surface</item>
    </style>

    <style name="viewParent.headerText.NoMode" parent="viewParent.headerText">
        <item name="android:textColor">@color/ludo_on_surface_variant</item>
    </style>

    <style name="parent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="modifiedEditText" parent="parent">
        <item name="android:textSize">16sp</item>
        <item name="android:backgroundTint">@color/ludo_secondary</item>
    </style>

    <style name="loginButton" parent="Widget.Ludo.Button">
        <item name="android:textColor">@color/ludo_on_primary</item>
    </style>

    <style name="spinnerHintText" parent="parent">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ludo_secondary</item>
        <item name="android:paddingLeft">5dp</item>
    </style>

    <style name="personal_collapsed_title" parent="TextStyle.Ludo.TitleMedium">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="personal_expanded_title" parent="TextStyle.Ludo.TitleSmall">
        <item name="android:textColor">@android:color/transparent</item>
    </style>
</resources>
